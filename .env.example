# Nyilvános HTTPS-végpont, amely a kapcsolatfelvételi űrlapot JSON-ként (POST) fogadja
# és ténylegesen el is menti / továbbítja. 2xx válasz = sikeres mentés.
# Példák: Make vagy Zapier webhook, Formspree űrlap, saját szerverfüggvény.
# Titkos kulcsot NE tegyél ide – minden VITE_ változó bekerül a böngészőbe.
VITE_CONTACT_ENDPOINT=

# Az adatkezelési tájékoztató URL-je. Ha meg van adva, megjelenik az űrlapnál és a láblécben.
VITE_PRIVACY_URL=
